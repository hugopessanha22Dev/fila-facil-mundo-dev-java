# Copie para .env e ajuste. Nunca commite .env com secrets reais.

FILAFACIL_API_MODE=local
FILAFACIL_API_PORT=8080

# Use jdbc:postgresql://... com docker compose, ou "memory" para smoke sem Docker
FILAFACIL_DB_URL=jdbc:postgresql://localhost:5432/filafacil
FILAFACIL_DB_USER=filafacil
FILAFACIL_DB_PASSWORD=filafacil

FILAFACIL_S3_BUCKET=
FILAFACIL_AWS_REGION=us-east-1
FILAFACIL_ANEXOS_DIR=data/anexos
FILAFACIL_MAX_ANEXO_BYTES=2097152

# Auditoria (Banco de Dados Inter) — menu opcao 10
FILAFACIL_AUDITORIA=on
# FILAFACIL_DB_URL=memory  # fallback sem Docker
FILAFACIL_REDIS_HOST=localhost
FILAFACIL_REDIS_PORT=6379
FILAFACIL_REDIS_TTL_SECONDS=60
FILAFACIL_MONGO_URI=mongodb://localhost:27017
FILAFACIL_MONGO_DB=filafacil_auditoria

# Pipeline batch (Data Engineering) — menu opcao 11 / exec:java@pipeline
FILAFACIL_PIPELINE_ROOT=data/pipeline
FILAFACIL_PIPELINE_RETRIES=2

# Pipeline inter (CDC/incremental) — menu opcao 12 / exec:java@pipeline --mode incremental
FILAFACIL_PIPELINE_LATE_POLICY=mark
FILAFACIL_PIPELINE_PARALLELISM=4

# LLM. mock nao chama a rede. http exige chave (Groq na cota gratis encaixa no cliente atual).
FILAFACIL_LLM_MODE=mock
FILAFACIL_LLM_API_KEY=
FILAFACIL_LLM_BASE_URL=https://api.groq.com/openai/v1
FILAFACIL_LLM_MODEL_LIGHT=openai/gpt-oss-20b
FILAFACIL_LLM_MODEL_DETAILED=openai/gpt-oss-120b
FILAFACIL_LLM_TIMEOUT_SECONDS=45
FILAFACIL_LLM_MAX_RETRIES=2
FILAFACIL_LLM_PRICE_PER_1K=0.000075

# Assistente cloud de triagem. mock e o caminho gratuito. http usa a Groq (ou Gemini), nunca api.openai.com.
FILAFACIL_AI_ENV=dev
FILAFACIL_AI_GATEWAY=mock
FILAFACIL_AI_CACHE=memory


